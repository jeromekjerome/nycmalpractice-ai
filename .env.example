# Database (Neon Postgres — separate from other AntiGravity DBs)
DATABASE_URL=postgresql://user:pass@host/malpractice_ai

# OpenAI
OPENAI_API_KEY=sk-...

# The models each job uses are not set here. They are a setting kept in the database and saved from the admin page,
# checked before it is saved (model-settings.js); until chains are saved, the built-in ones in models.js are used.
# Site-wide estimated OpenAI spend limits in USD, shared across all server instances (defaults shown).
AI_DAILY_CAP_USD=25
AI_MONTHLY_CAP_USD=200

# Optional nightly off-site backups to S3-compatible object storage. Skipped unless every required value is set.
BACKUP_BUCKET=
BACKUP_REGION=
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=
# Base64-encoded 32-byte key used to encrypt records before upload. Keep a separate restore copy.
BACKUP_ENCRYPTION_KEY=
# BACKUP_ENDPOINT=https://your-s3-compatible-endpoint
# BACKUP_PREFIX=nycmalpractice
# Required retention control: configure the bucket lifecycle to delete backup objects after 35 days.

# CourtListener (optional — for malpractice case law)
COURTLISTENER_TOKEN=your-courtlistener-token

# SMTP (Siteground / mail.jwd.nyc)
SMTP_HOST=mail.jwd.nyc
SMTP_PORT=465
SMTP_USER=noreply@nycmalpractice.ai
SMTP_PASS=your-smtp-password

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...   # NYCMalpractice.ai Subscription — $199/month

# Twilio (phone verification for firms)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

# App
APP_URL=https://nycmalpractice.ai
PORT=3003
CRON_SECRET=your-cron-secret
ADMIN_SECRET=your-admin-secret
# The same secret, read by `npm run models:upload` (measure/upload.mjs) and by nothing else, which sends the model
# measurements to the site. It is never typed on a command line. Leave it empty in the site's own settings.
ADMIN_SECRET_FOR_UPLOAD=
NOTIFICATION_EMAIL=jeromekjerome@gmail.com

# Optional
# Space-separated CourtListener court ids searched first (default: New York Court of Appeals,
# Supreme Court and Appellate Division); a national search is the fallback when they return nothing.
# COURTLISTENER_COURTS=ny nysupct nyappdiv
# How long a chat reply waits for the conversation to be saved and a lead to be handed off before
# it is sent anyway, in milliseconds (default 20000).
# ASK_FOLLOW_UP_WORK_CAP_MS=20000
