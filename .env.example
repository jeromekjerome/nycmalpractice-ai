# Database (Neon Postgres — separate from other AntiGravity DBs)
DATABASE_URL=postgresql://user:pass@host/malpractice_ai

# OpenAI
OPENAI_API_KEY=sk-...

# CourtListener (optional — for malpractice case law)
COURTLISTENER_TOKEN=your-courtlistener-token

# SMTP (Siteground / mail.jwd.nyc)
SMTP_HOST=mail.jwd.nyc
SMTP_PORT=465
SMTP_USER=noreply@nycmalpractice.ai
SMTP_PASS=your-smtp-password

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...   # NYCMalpractice.ai Subscription — $199/month

# Twilio (phone verification for firms)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

# App
APP_URL=https://nycmalpractice.ai
PORT=3003
CRON_SECRET=your-cron-secret
ADMIN_SECRET=your-admin-secret
NOTIFICATION_EMAIL=jeromekjerome@gmail.com

# Optional
# Space-separated CourtListener court ids searched first (default: New York Court of Appeals,
# Supreme Court and Appellate Division); a national search is the fallback when they return nothing.
# COURTLISTENER_COURTS=ny nysupct nyappdiv
# How long a chat reply waits for the conversation to be saved and a lead to be handed off before
# it is sent anyway, in milliseconds (default 20000).
# ASK_FOLLOW_UP_WORK_CAP_MS=20000
