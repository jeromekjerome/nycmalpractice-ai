{
  "version": 2,
  "framework": null,
  "functions": {
    "api/index.js": {
      "includeFiles": "{public,rubrics,content}/**",
      "maxDuration": 60
    },
    "api/jobs.js": {
      "includeFiles": "{public,rubrics,content}/**",
      "maxDuration": 300
    }
  },
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www\\.nycmalpractice\\.ai" }],
      "destination": "https://nycmalpractice-ai.vercel.app/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www\\.nycmalpractice\\.ai" }],
      "destination": "https://nycmalpractice-ai.vercel.app/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/cron/library",
      "destination": "/api/jobs"
    },
    {
      "source": "/api/cron/screen",
      "destination": "/api/jobs"
    },
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/library",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/screen?run=1",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/screen?run=2",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/statute-watch",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron",
      "schedule": "0 7 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.mxpnl.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://api-js.mixpanel.com https://api.mixpanel.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    }
  ]
}
